# Copier ce fichier en .env et remplir avec les vraies valeurs (jamais commiter .env).
# Ces comptes (Shopify Partner, Supabase) sont à créer par le propriétaire du projet,
# cf. section 8 du cahier des charges.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,read_all_orders

# Chaîne de connexion Supabase Postgres (pooler transaction, port 6543). Le paramètre
# ?pgbouncer=true est obligatoire avec Prisma sur ce type de pooler, sans quoi des
# erreurs incohérentes ("table does not exist" alors qu'elle existe) peuvent survenir.
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
