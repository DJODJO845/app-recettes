# Copier ce fichier en .env et remplir avec les vraies valeurs (jamais commiter .env).
# Ces comptes (Shopify Partner, Supabase) sont à créer par le propriétaire du projet,
# cf. section 8 du cahier des charges.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# Doit toujours correspondre EXACTEMENT à [access_scopes].scopes dans shopify.app.toml —
# les deux sont lus indépendamment (celui-ci au runtime par shopify.server.ts, l'autre au
# déploiement par Shopify) et un écart entre les deux peut faire échouer l'OAuth ou faire
# tourner l'app avec un scope que Shopify n'a pas approuvé. read_all_orders est un scope
# protégé retiré tant que la demande d'accès n'est pas approuvée (voir shopify.app.toml) :
# ne le rajouter ICI qu'en même temps que dans shopify.app.toml, jamais avant.
SCOPES=read_orders

# Chaîne de connexion Supabase Postgres (pooler transaction, port 6543). Le paramètre
# ?pgbouncer=true est obligatoire avec Prisma sur ce type de pooler, sans quoi des
# erreurs incohérentes ("table does not exist" alors qu'elle existe) peuvent survenir.
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Rappel email de fin de période (app/routes/api.cron.rappels-echeance.tsx), déclenché
# une fois par jour par .github/workflows/rappel-echeance.yml (secrets GitHub APP_URL
# et CRON_SECRET, ce dernier devant être identique à la valeur ci-dessous).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Recettes URSSAF <onboarding@resend.dev>
CRON_SECRET=

# IMPORTANT (app.tsx) : reste absent/"false" tant qu'on n'est pas prêt à facturer de
# vrais clients — sans ça, l'abonnement est en mode test (aucun vrai paiement demandé).
# À passer à "true" sur l'hébergeur (Render) uniquement, juste avant l'ouverture au public.
SHOPIFY_BILLING_LIVE=false
