// Schéma Prisma — Supabase Postgres.
// Conçu pour l'isolation multi-boutiques : chaque table métier porte `shopDomain` et
// une politique Row Level Security (RLS) Postgres doit filtrer dessus côté base (cf.
// docs/phase-2-architecture.md, section SÉCURITÉ). Prisma seul ne suffit pas : la RLS
// est un filet de sécurité indépendant du code applicatif.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Periodicite {
  MENSUELLE
  TRIMESTRIELLE
}

enum TypeActivite {
  COMMERCE
  SERVICES
  MIXTE
}

enum NatureLigne {
  VENTE
  VENTE_CARTE_CADEAU
  REGLEMENT_CARTE_CADEAU
  REMBOURSEMENT
}

model Boutique {
  id                 String       @id @default(uuid())
  shopDomain         String       @unique
  typeActivite       TypeActivite @default(COMMERCE)
  periodicite        Periodicite  @default(TRIMESTRIELLE)
  dateDebutActivite  DateTime
  // Adresse pour le rappel email de fin de période (api.cron.rappels-echeance.tsx).
  // Si absent, on utilise l'email du compte Shopify (shop.email) à la place.
  emailRappel        String?
  // Date du dernier export (CSV ou PDF), pour n'afficher le bandeau de rappel
  // d'export (BanniereExport) que si le marchand n'a pas exporté récemment,
  // plutôt qu'à chaque visite du Dashboard.
  derniereExportation DateTime?
  // Date du dernier import réussi des commandes Shopify (importerCommandesRecentes),
  // pour importer seulement les commandes récentes à chaque visite plutôt que de
  // retélécharger tout l'historique depuis dateDebutActivite à chaque fois. Remise à
  // null quand dateDebutActivite change (mettreAJourReglages), pour forcer un import
  // complet depuis la nouvelle date.
  derniereImportation DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  lignesLivre LigneLivre[]
}

// Une ligne = un encaissement ou un remboursement réel. JAMAIS de mise à jour d'une
// ligne existante après création (pas de méthode "update" exposée côté application) :
// une correction s'écrit comme une nouvelle ligne, référençant l'originale via
// `corrigeLigneId`. Conservation obligatoire 10 ans (section 3 du cahier des charges).
model LigneLivre {
  id             String      @id @default(uuid())
  shopDomain     String
  boutique       Boutique    @relation(fields: [shopDomain], references: [shopDomain])

  // Identifiant de la transaction Shopify d'origine, pour idempotence des imports.
  transactionId  String      @unique

  dateEncaissement DateTime
  reference        String
  // Nom du client si l'accès aux protected customer data est accordé, sinon "Client".
  // Anonymisé (remplacé par "Client") lors d'un webhook customers/redact, sans jamais
  // supprimer la ligne elle-même (obligation de conservation 10 ans).
  client           String
  // Identifiant Shopify (GID) du client, utilisé pour retrouver ses lignes de façon
  // fiable lors des webhooks RGPD (le nom affiché seul n'est pas un identifiant sûr).
  clientId         String?
  nature           NatureLigne
  montant          Decimal     @db.Decimal(12, 2)
  modeReglement    String
  canal            String
  compteDansCA     Boolean
  avertissement    String?

  // Renseigné uniquement si cette ligne corrige une ligne antérieure erronée.
  corrigeLigneId   String?

  createdAt        DateTime    @default(now())

  @@index([shopDomain, dateEncaissement])
  @@index([shopDomain, clientId])
}

// Stockage des sessions Shopify (remplace le stockage SQLite par défaut du template
// React Router), conforme au choix Supabase de la Phase 2. Champs alignés sur ceux
// attendus par @shopify/shopify-app-session-storage-prisma.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?  @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  // @shopify/shopify-app-session-storage-prisma vérifie l'existence de la table par
  // son nom exact en minuscules ("session") — sans ce mapping, Prisma créerait/
  // chercherait "Session" (majuscule), que Postgres traite comme un nom différent.
  @@map("session")
}
